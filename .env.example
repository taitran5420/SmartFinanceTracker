DB_URL=your_db_url
DB_DATABASE=your_db_name
DB_USERNAME=root
DB_PASSWORD=your_password_here

JWT_SECRET=your-super-secret-key-your-super-secret-key
JWT_EXPIRATION=86400000

# Optional: comma-separated CORS origins allowed to call the API.
# Defaults to http://localhost:3000,http://localhost:5173 when unset.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: Quartz cron for processing due recurring transactions.
# Defaults to every 5 minutes ("0 0/5 * * * ?") when unset. Use "0 0/1 * * * ?" for testing.
RECURRING_CRON='0 0/5 * * * ?'

# Optional: Redis connection used to cache the analytics endpoints.
# Defaults to localhost:6379 (the docker-compose service) when unset.
REDIS_HOST=localhost
REDIS_PORT=6379

# Grafana admin password (monitoring stack, docker-compose --profile full).
# Grafana itself defaults to "admin" if this is left unset.
GF_SECURITY_ADMIN_PASSWORD=your_grafana_admin_password